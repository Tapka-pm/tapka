<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../InstalledPackages.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tapka-setup-win-x64</AssemblyName>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants Condition="'$(TapkaTestBuild)' == 'true'">$(DefineConstants);TAPKA_TEST_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Tapka.Terminal/Tapka.Terminal.csproj" />
    <ProjectReference Include="../Tapka.Progress/Tapka.Progress.csproj" />
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
    <Compile Include="../tapka/*.cs" Exclude="../tapka/Program.cs;../tapka/TapkaCli.cs;../tapka/InventoryCommands.cs" />
    <AssemblyMetadata Include="TapkaVersion" Value="$(Version)" />
  </ItemGroup>
  <PropertyGroup>
    <EmbedNativeShim>true</EmbedNativeShim>
  </PropertyGroup>
  <Import Project="../shim/shim.targets" />
  <Target Name="EmbedSqlite" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolvePackageAssets">
    <ItemGroup>
      <_SqliteDll Include="@(NativeCopyLocalItems)" Condition="'%(Filename)%(Extension)' == 'e_sqlite3.dll'" />
      <EmbeddedResource Include="@(_SqliteDll)" LogicalName="tapka.e_sqlite3.dll" />
    </ItemGroup>
    <Error Condition="'@(_SqliteDll)' == ''" Text="The SQLite native library for $(RuntimeIdentifier) was not resolved." />
  </Target>
</Project>
