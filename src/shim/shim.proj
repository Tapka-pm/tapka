<Project DefaultTargets="Build">
  <Import Project="shim.targets" />
  <PropertyGroup>
    <ProbeSource>$(MSBuildThisFileDirectory)../../tests/Shim.Tests/probe.c</ProbeSource>
  </PropertyGroup>

  <Target Name="Build" DependsOnTargets="BuildNativeShim" />

  <Target Name="BuildProbe" DependsOnTargets="ValidateNativeShim" Inputs="$(MSBuildProjectFullPath);$(ShimTargetsFile);$(ShimCompilerScript);$(ProbeSource)"
          Outputs="$(ShimOutputDirectory)/shim-probe.exe">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ShimCompilerScript)&quot; -Source &quot;$(ProbeSource)&quot; -Output &quot;$(ShimOutputDirectory)/shim-probe.exe&quot;" />
  </Target>
</Project>
