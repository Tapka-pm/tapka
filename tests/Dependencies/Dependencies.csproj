<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../src/InstalledPackages.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);TAPKA_TEST_BUILD</DefineConstants>
    <ShimPath>../../artifacts/build/shim/Release/x64/shim.exe</ShimPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/tapka/*.cs" Exclude="../../src/tapka/Program.cs;../../src/tapka/InventoryCommands.cs" />
    <EmbeddedResource Include="$(ShimPath)" LogicalName="tapka.shim.exe" />
  </ItemGroup>
</Project>
