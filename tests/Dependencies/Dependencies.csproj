<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../src/InstalledPackages.props" />
  <Import Project="../../src/Win32.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);TAPKA_TEST_BUILD</DefineConstants>
    <ShimPath>../../artifacts/build/shim/Release/x64/shim.exe</ShimPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Tapka.Terminal.Testing/Tapka.Terminal.Testing.csproj" />
    <ProjectReference Include="../../src/Tapka.Progress/Tapka.Progress.csproj" />
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
    <Compile Include="../../src/tapka/*.cs" Exclude="../../src/tapka/Program.cs" />
    <EmbeddedResource Include="$(ShimPath)" LogicalName="tapka.shim.exe" />
  </ItemGroup>
</Project>
