<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../InstalledPackages.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile Condition="'$(TapkaTestBuild)' == 'true'">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(TapkaTestBuild)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <AppHostDotNetSearch Condition="'$(TapkaTestBuild)' != 'true'">EnvironmentVariable</AppHostDotNetSearch>
    <DebugType>embedded</DebugType>
    <DefineConstants Condition="'$(TapkaTestBuild)' == 'true'">$(DefineConstants);TAPKA_TEST_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
  </ItemGroup>
  <PropertyGroup>
    <EmbedNativeShim>true</EmbedNativeShim>
  </PropertyGroup>
  <Import Project="../shim/shim.targets" />
</Project>
